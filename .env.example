# Salin menjadi .env untuk development lokal. Di Vercel, isi lewat Project Settings → Environment Variables.

# Akun admin (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Rahasia untuk menandatangani sesi login. Isi string acak panjang, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wajib di Vercel. Di lokal boleh kosong (sesi hilang tiap server restart).
SESSION_SECRET=

# Database Postgres (Neon). Di Vercel terisi otomatis setelah menghubungkan Neon dari Storage/Marketplace.
# Kosongkan di lokal untuk menyimpan konten ke file .data/content.json.
DATABASE_URL=

# Penyimpanan gambar (Vercel Blob). Di Vercel terisi otomatis setelah membuat Blob store.
# Kosongkan di lokal untuk menyimpan unggahan ke public/uploads/.
BLOB_READ_WRITE_TOKEN=
